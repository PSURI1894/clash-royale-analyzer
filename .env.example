# ---- Database ----
# Local dev (no Docker required): SQLite file.
DATABASE_URL=sqlite:///./cr_helper.sqlite3
# Full stack (Docker): uncomment to use Postgres + pgvector.
# DATABASE_URL=postgresql+psycopg://cr:cr@localhost:5432/cr_helper

# ---- cr-api-data (static combat stats source) ----
CR_DATA_BASE_URL=https://royaleapi.github.io/cr-api-data/json

# ---- Official Clash Royale API (Phase 3 — battle-log mining) ----
# NOTE: keys are locked to fixed IP(s). Leave blank until Phase 3.
CLASH_ROYALE_API_TOKEN=

# ---- LLM (Phase 4 — RAG advisor) ----
ANTHROPIC_API_KEY=
