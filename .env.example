# ---- Database ----
# Local dev (no Docker required): SQLite file.
DATABASE_URL=sqlite:///./cr_helper.sqlite3
# Full stack (Docker): uncomment to use Postgres + pgvector.
# DATABASE_URL=postgresql+psycopg://cr:cr@localhost:5432/cr_helper

# ---- cr-api-data (static combat stats source) ----
CR_DATA_BASE_URL=https://royaleapi.github.io/cr-api-data/json

# ---- Official Clash Royale API (Phase 3 — battle-log mining) ----
# NOTE: keys are locked to fixed IP(s). Leave blank until Phase 3.
CLASH_ROYALE_API_TOKEN=

# ---- Knowledge graph (Phase 2) ----
GRAPH_BACKEND=sql                 # sql (Docker-free) | neo4j (full stack)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password123

# ---- LLM + embeddings (Phase 4 — RAG advisor) ----
ANTHROPIC_API_KEY=
ADVISOR_BACKEND=auto              # auto (Claude if key else stub) | stub | claude
EMBED_BACKEND=hashing             # hashing (offline) | voyage
# VOYAGE_API_KEY=

# ---- Scraping + productionization (Phase 6) ----
SCRAPE_ALLOW_NETWORK=false        # must be true (and ToS-checked) to hit the network
RATE_LIMIT_PER_MIN=120
CACHE_TTL_SECONDS=60
